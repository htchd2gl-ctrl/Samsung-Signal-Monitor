{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "de.signalmonitor.monitor",
  "Name": "Samsung Signal Monitor",
  "Version": "0.2.0.0",
  "Author": "Private Project",
  "Description": "Private Windows/Tailscale phone signal monitor",
  "CodePath": "plugin.js",
  "SDKVersion": 2,
  "Nodejs": {
    "Version": "24"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Icon": "img/icon",
  "Category": "Samsung Signal Monitor",
  "CategoryIcon": "img/icon",
  "Actions": [
    {
      "UUID": "de.signalmonitor.monitor.fold7",
      "Name": "Galaxy Z Fold7",
      "Tooltip": "Signal of the Fold7",
      "Icon": "img/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "img/icon"
        }
      ]
    },
    {
      "UUID": "de.signalmonitor.monitor.xcover6",
      "Name": "XCover6 Pro",
      "Tooltip": "Signal of the XCover6 Pro",
      "Icon": "img/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "img/icon"
        }
      ]
    }
  ]
}